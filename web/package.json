{
  "name": "klucode-web",
  "version": "1.0.0",
  "private": true,
  "description": "klucode.de — the KluCode website. Static export, no runtime dependencies, no third-party requests.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/emit-root-redirect.mjs && node scripts/emit-404.mjs",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:profile": "node scripts/check-profile.mjs",
    "check:meta": "node scripts/check-meta.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:palette": "node scripts/check-scene-palette.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "playwright test --config=playwright.config.ts",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3",
    "nanoid": "^3.3.18"
  }
}

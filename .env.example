# ─── CafeTab environment ────────────────────────────────────────────────
# Copy to `.env.local` and fill in from your Supabase project settings.
# (Settings → API). NEVER commit real values.

# Public — safe to expose to the browser. Reads/writes are gated by RLS (§7).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used solely by the append-only e2e test to provision/clean up
# fixtures. This key bypasses RLS, so it must NEVER reach the browser or be
# imported by any file under app/ or components/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

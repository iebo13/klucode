  "glass": {
    "$comment": "Liquid glass, not flat frosted glass. A plain backdrop-blur panel is a hole cut in a sheet; this layer is a slab with thickness. rim/rimLow are the specular edge lights, spec/specLow the directional sweep across the face, cast the ambient shadow it floats on, and depth the interior shading that gives the slab a bottom. Fills are lower than flat frosted glass would allow (0.44 light / 0.50 dark) because liquid glass has to TRANSMIT the colour behind it — at 0.66 the panels just read as white cards. The guardrail is not a fixed opacity, it is the measured audit: composited contrast is sampled from rendered pixels and every text role must clear its WCAG threshold. Change a fill, re-run the audit.",
    "light": {
      "fill": "rgba(255, 255, 255, 0.44)",
      "fillStrong": "rgba(255, 255, 255, 0.72)",
      "border": "rgba(255, 255, 255, 0.65)",
      "edge": "rgba(12, 26, 21, 0.07)",
      "rim": "rgba(255, 255, 255, 0.95)",
      "rimLow": "rgba(255, 255, 255, 0.5)",
      "spec": "rgba(255, 255, 255, 0.6)",
      "specLow": "rgba(255, 255, 255, 0.26)",
      "cast": "rgba(12, 26, 21, 0.16)",
      "depth": "rgba(12, 26, 21, 0.32)",
      "shadow": "0 1px 2px rgba(12, 26, 21, 0.03), 0 12px 32px -8px rgba(12, 26, 21, 0.10)"
    },
    "dark": {
      "fill": "rgba(34, 48, 42, 0.5)",
      "fillStrong": "rgba(34, 48, 42, 0.82)",
      "border": "rgba(169, 181, 174, 0.2)",
      "edge": "rgba(255, 255, 255, 0.06)",
      "rim": "rgba(255, 255, 255, 0.34)",
      "rimLow": "rgba(255, 255, 255, 0.1)",
      "spec": "rgba(255, 255, 255, 0.16)",
      "specLow": "rgba(255, 255, 255, 0.06)",
      "cast": "rgba(0, 0, 0, 0.55)",
      "depth": "rgba(0, 0, 0, 0.6)",
      "shadow": "0 1px 2px rgba(0, 0, 0, 0.20), 0 12px 32px -8px rgba(0, 0, 0, 0.45)"
    },
    "blur": "12px",
    "saturate": "1.9"
  },
  "role": {
    "$comment": "Two designed themes, not one theme and its inversion. Light builds hierarchy by going DARKER as elements recede; dark builds it by going LIGHTER as elements are raised, which is how physical light works and what dark mode actually needs. Dark also uses off-white text rather than pure white, and moves the accent UP the scale where the chroma taper has already softened it — saturated colour on a dark ground vibrates. Dark muted text sits at stone.300, not 400: measured against the header capsule over a lit area, 400 came out at 4.31:1 — below AA. Dark grounds eat contrast that light grounds do not.",
    "light": {
      "surface": "stone.50",
      "surfaceAlt": "viridian.50",
      "surfaceRaised": "stone.50",
      "surfaceInverse": "stone.950",
      "border": "stone.200",
      "text": "stone.950",
      "textMuted": "stone.700",
      "brand": "viridian.500",
      "brandText": "viridian.700",
      "brandAction": "viridian.700",
      "onBrand": "stone.50"
    },
    "dark": {
      "surface": "stone.950",
      "surfaceAlt": "viridian.950",
      "surfaceRaised": "stone.900",
      "surfaceInverse": "stone.50",
      "border": "stone.800",
      "text": "stone.100",
      "textMuted": "stone.300",
      "brand": "viridian.400",
      "brandText": "viridian.300",
      "brandAction": "viridian.400",
      "onBrand": "stone.950"
    }
  },
